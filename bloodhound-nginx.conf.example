# Ejemplo de Nginx para servir la app en el prefijo `/bloodhound`
# y proxyear al servidor Node en `127.0.0.1:5000`.
#
# Importante:
# - El frontend genera URLs tipo `/bloodhound/api/...`
# - Este config "strippea" `/bloodhound` antes de llegar a Express (`/api/...`)
# - Sustituye `tod.com.co` por tu dominio real (y agrega `www` si aplica).

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name tod.com.co www.tod.com.co;

  # Redirección opcional: si alguien entra a la raíz, lo mandamos al prefijo
  location = / { return 301 /bloodhound/; }
  location = /bloodhound { return 301 /bloodhound/; }

  location /bloodhound/ {
    rewrite ^/bloodhound/(.*)$ /$1 break;

    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 300s;
  }
}

server {
  listen 443 ssl http2;
  server_name tod.com.co www.tod.com.co;

  # Certbot llena estos paths normalmente:
  # ssl_certificate /etc/letsencrypt/live/tod.com.co/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/tod.com.co/privkey.pem;

  location = / { return 301 /bloodhound/; }
  location = /bloodhound { return 301 /bloodhound/; }

  location /bloodhound/ {
    rewrite ^/bloodhound/(.*)$ /$1 break;

    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 300s;
  }
}

