AWS_PROFILE=default
AWS_REGION=us-east-1
SERVICE_NAME=bloodhound-prod
POWER=micro
SCALE=1
CONTAINER_NAME=app
CONTAINER_PORT=5000
DOMAIN=bloodhound.example.com

# Solo build + push al registry Lightsail; deploy en consola u otro usuario IAM (CreateContainerServiceDeployment)
# SKIP_LIGHTSAIL_DEPLOY=1

# Runtime envs (required)
DATABASE_URL=postgresql://administrator_admin_bloodhound:%23.%2984w5%3FG%3BC%5Es9T2@70.38.95.210:5432/administrator_bloodhound
ADMIN_API_TOKEN=replace_me
QUIZ_CHALLENGE_SECRET=replace_me
VITE_ADMIN_API_TOKEN=replace_me

# Optional runtime envs
NODE_ENV=production
PORT=5000
UI_BASE_PATH=/
UPLOADS_DIR=/app/uploads
DEFAULT_CAMPAIGN_SLUG=default

# S3 uploads — UPLOADS_BACKEND=s3 en producción. Probar: npm run test:s3-credentials
# Estas AWS_* van solo al JSON del contenedor; build-push-deploy.bat ya no las exporta a la CLI de tu PC.
# UPLOADS_BACKEND=local
# S3_BUCKET=fow-tod-data
# S3_REGION=us-east-1
# S3_PREFIX=bloodhound
# S3_PUBLIC_BASE_URL=https://fow-tod-data.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
