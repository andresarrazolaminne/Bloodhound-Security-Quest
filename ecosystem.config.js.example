// Ejemplo para PM2 (ajusta APP_DIR / DATABASE_URL si aplica)
// Ejecutar desde la carpeta del proyecto (ej: /var/www/bloodhound):
//   pm2 start ecosystem.config.js
//   pm2 save

module.exports = {
  apps: [
    {
      name: "bloodhound",
      script: "dist/index.js",
      cwd: process.env.APP_DIR || process.cwd(),
      // No dependemos de PORT en runtime (server fija 5000),
      // pero lo dejamos por claridad.
      env: {
        NODE_ENV: "production",
        PORT: "5000",
        DATABASE_URL: process.env.DATABASE_URL,
      },
      instances: 1,
      autorestart: true,
      watch: false,
      max_memory_restart: "512M",
      time: true,
    },
  ],
};

